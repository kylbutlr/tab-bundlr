{
  "manifest_version": 3,
  "name": "Tab Bundlr",
  "version": "0.8.1",
  "description": "Organize browser tabs into predictable workspaces using transparent URL rules.",
  "icons": {
    "16": "icons/chrome/icon-16.png",
    "32": "icons/chrome/icon-32.png",
    "48": "icons/chrome/icon-48.png",
    "128": "icons/chrome/icon-128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "tabGroups"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "temporarily-invert-link-activation": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Invert link tab activation for 10 seconds"
    },
    "activate-previous-tab": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      },
      "description": "Activate the previous tab"
    }
  },
  "action": {
    "default_title": "Tab Bundlr",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/chrome/icon-16.png",
      "32": "icons/chrome/icon-32.png"
    }
  },
  "options_page": "options.html"
}
